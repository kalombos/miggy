{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/opencode/tochka/ai-instructions/rules/*.md"],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow"
    },
    "todowrite": "allow",
    "task": "allow",
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "jb *": "allow",
      "uv *": "allow",
      "python *": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}